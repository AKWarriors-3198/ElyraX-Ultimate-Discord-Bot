# Discord OAuth app. Keep all secrets server-side.
DISCORD_CLIENT_ID=1550890851926937650
DISCORD_CLIENT_SECRET=4Yx4esk0miDSuZlgTJqnkTfLXIHHg8Vb
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Random 32+ character session encryption secret. Use a unique value per environment.
NEXTAUTH_SECRET=

# Discord bot token is used only on the server to verify installation and load channels/roles.

ELYRAX_INVITE_URL=https://discord.com/oauth2/authorize?client_id=1550890851926937650&permissions=8&integration_type=0&scope=bot

# Optional private bot API bridge. Never prefix these with NEXT_PUBLIC_.
ELYRAX_API_URL=http://localhost:8000
ELYRAX_API_SECRET=

# Local SQLite database. Back up this file and its WAL files while the app is stopped.
DATABASE_PATH=./data/elyrax.db

DISCORD_BOT_TOKEN=
